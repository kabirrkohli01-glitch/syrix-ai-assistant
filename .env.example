# Copy to .env and fill in only the providers you use. A lane whose key is
# missing is simply unavailable; the local Ollama model is always the floor.

# Model lanes
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
# GitHub Models
GITHUB_TOKEN=

# Optional backup keys, used while the primary is rate-limited
GROQ_API_KEY_2=
OPENROUTER_API_KEY_2=

# Optional keyed search lanes
TAVILY_API_KEY=
EXA_API_KEY=
